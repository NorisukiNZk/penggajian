Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses HTTP langsung ke direktori sensitif & VCS
    RewriteRule ^(\.git|\.github|vendor|tests|application|system)(/|$) - [F,L,NC]
    RewriteRule "^db database(/|$)" - [F,L,NC]

    # Blokir akses HTTP langsung ke file konfigurasi, migrasi SQL, dan arsip sensitif
    RewriteRule (^|/)(composer\.(json|lock)|phpunit\.xml|\.env(\..+)?|\.htaccess|\.editorconfig)$ - [F,L,NC]
    RewriteRule \.(sql|log|bak|ini|sh|yml|yaml)$ - [F,L,NC]

    # Routing standar CodeIgniter 3
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
